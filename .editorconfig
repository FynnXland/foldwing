# https://editorconfig.org – einheitliche Grundformatierung für alle Editoren.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,cjs,json,css,html,md,yml,yaml,toml,sh,nsh}]
end_of_line = lf

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.{ts,tsx,js,mjs,cjs,json,css,html,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

# Zwei Leerzeichen am Zeilenende sind in Markdown ein Zeilenumbruch.
[*.md]
trim_trailing_whitespace = false
